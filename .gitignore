node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# pr-self-review verdict + report + runs log (per-machine, per-branch state)
.claude/.pr-self-review/

# Implementation Plans relayed to subagents (per-machine scratch, never committed).
# MUST stay ignored: diff-hash.sh hashes untracked file content, so a visible plan
# file would move the tree fingerprint and make every verdict stale.
# Written as `/*` rather than `/` so the one exception below can re-include a
# directory: git cannot re-include anything whose PARENT directory is excluded.
.claude/.plans/*

# ONE exception, on purpose: the SDD pipeline artefacts for SPEC-02, which are the
# lesson's deliverable and are meant to be read from the repository rather than from
# one machine's scratch. The rule above still holds for every other plan.
#
# The constraint it trades against is real, so it is written down: an un-ignored file
# enters diff-hash.sh's fingerprint, as untracked CONTENT while it is uncommitted and
# as part of `base...HEAD` once it is committed. So each artefact here is COMMITTED
# BEFORE a /pr-self-review verdict is recorded. Committed, it is stable and the
# verdict stays fresh; left uncommitted and edited, it would move the hash under an
# already-recorded verdict — which is exactly what the rule above exists to prevent.
!.claude/.plans/onboarding-generator/

# The same exception, for the same reason, for SPEC-03 (PR Brief). Its acceptance criteria
# require the spec and the plan to be committed BEFORE the feature's code, so the plan has
# to be a tracked file rather than one machine's scratch. The diff-hash.sh constraint above
# applies here unchanged: commit each artefact before recording a /pr-self-review verdict.
!.claude/.plans/pr-brief/

# The same exception, for the same reason, for SPEC-04 (Eval Pipeline). L06's homework
# requires the feature to go through spec-driven development, and a pipeline nobody can
# read afterwards has not been demonstrated — so the plan is a tracked artefact, not one
# machine's scratch. The diff-hash.sh constraint above applies here unchanged: commit each
# artefact before recording a /pr-self-review verdict.
!.claude/.plans/eval-pipeline/

# L06 course material and working notes — the assignment text, the reference mockups it
# shipped with, and a scratch note. These describe the homework; they are not part of the
# product, and a reviewer reads the spec and the code instead.
/HOME-TASK06.md
/ORDER-TASKS
/HOME-TASK-SCREENSHOTS/
.claude/settings.local.json

# Reference design exports dropped in for UI work — single-file HTML with
# fonts inlined as base64, ~40MB. Kept out of history on purpose: it cannot be
# taken back out once committed, and every clone would carry it forever.
/design fixes/
