node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# pr-self-review verdict + report + runs log (per-machine, per-branch state)
.claude/.pr-self-review/

# Implementation Plans relayed to subagents (per-machine scratch, never committed).
# MUST stay ignored: diff-hash.sh hashes untracked file content, so a visible plan
# file would move the tree fingerprint and make every verdict stale.
.claude/.plans/
